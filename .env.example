# Required: Cursor user or service-account API key
# https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Optional: pin model when Router (auto-smart) is unavailable
# CURSOR_MODEL_FALLBACK=composer-2.5

# Kill switch: investigate only, no pipeline/** edits
# HEAL_DRY_RUN=1

# Webhook server
# PORT=8787

# Snowflake auth lives in Cortex CLI connections — do not put passwords here.
# Prerequisite: `which cortex` && `cortex connections list`
# Demo account identifier: NPSZJKJ-QP25178 (host: NPSZJKJ-QP25178.snowflakecomputing.com)
# Active connection name should be: NPSZJKJ-QP25178
# CORTEX_CONNECTION=NPSZJKJ-QP25178
# dbt: run `npm run dbt:profile` (writes gitignored dbt_heal/profiles.yml from connections.toml)
# Optional env overrides for profiles.yml.example:
# SNOWFLAKE_ACCOUNT=NPSZJKJ-QP25178
# SNOWFLAKE_USER=CZHU
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=ACCOUNTADMIN
